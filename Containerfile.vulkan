# B580 (Intel Battlemage) llama.cpp — Vulkan backend toolbox
# Build:  podman build -t localhost/b580-llamacpp-vulkan:latest -f Containerfile.vulkan .
# Create: toolbox create b580-vulkan --image localhost/b580-llamacpp-vulkan:latest \
#           -- --device /dev/dri --group-add video --group-add render \
#              --security-opt seccomp=unconfined
# Enter:  toolbox enter b580-vulkan

FROM fedora:44

# --- Vulkan runtime + SPIR-V toolchain ---
# spirv-headers-devel / spirv-tools-devel / glslang-devel are the ones that
# are easy to miss — cmake configure fails on SPIR-V-Headers otherwise.
RUN dnf install -y \
        mesa-vulkan-drivers \
        vulkan-loader \
        vulkan-loader-devel \
        vulkan-tools \
        glslc \
        spirv-headers-devel \
        spirv-tools \
        spirv-tools-devel \
        glslang-devel \
    && dnf clean all

# --- Build tooling ---
RUN dnf install -y \
        git cmake gcc-c++ make \
        libcurl-devel \
        procps-ng \
        htop \
    && dnf clean all

# --- Build llama.cpp with Vulkan backend ---
WORKDIR /opt
RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp

WORKDIR /opt/llama.cpp
RUN cmake -B build -DGGML_VULKAN=ON -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build -j$(nproc)

RUN echo 'export PATH=/opt/llama.cpp/build/bin:$PATH' >> /etc/profile.d/llamacpp.sh

# render/video group membership is granted at `toolbox create` time via
# --group-add, not baked into the image — group GIDs must match the host.

WORKDIR /opt/llama.cpp
